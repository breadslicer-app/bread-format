// Bread Converter's window: what to convert on the left, the files in the
// middle, progress and the buttons that start and stop along the bottom.
// Drawn with Breadslicer's kit (kit/), so it looks like one of the family.

import { Theme } from "kit/theme.slint";
import { Icons } from "kit/icons.slint";
import {
    Icon, ScButton, ButtonKind, Card, ScCheckBox, Segmented, ScLineEdit, ScProgress, StatTile,
    Dot, Note
} from "kit/controls.slint";
import { DialogHead, DialogRule } from "kit/dialog.slint";
import { ListView, AboutSlint } from "std-widgets.slint";
import "../assets/fonts/NotoSans-Variable.ttf";

// One file of the list.
export struct JobRow {
    name: string,
    // Where it is, the file in the way, or why it failed.
    detail: string,
    // What `detail` is: 0 the folder, 1 the file already there, 2 a file
    // the direction chosen does not convert, 3 why it failed, 4 where it went.
    reason: int,
    // "STL → .bread" or ".bread → STL".
    way: string,
    size: string,
    result: string,
    ratio: string,
    // 0 waiting, 1 converting, 2 done, 3 skipped, 4 failed.
    state: int,
}

// A column title of the list.
component Head inherits Text {
    font-size: Theme.font-xs;
    font-weight: 600;
    letter-spacing: 0.8px;
    color: Theme.text-faint;
    vertical-alignment: center;
}

// A number in a column of the list.
component Cell inherits Text {
    font-family: Theme.mono;
    font-size: Theme.font-sm;
    color: Theme.text-soft;
    horizontal-alignment: right;
    vertical-alignment: center;
}

component Row inherits Rectangle {
    in property <JobRow> job;
    in property <bool> odd;

    height: 42px;
    background: touch.has-hover ? Theme.hover : self.odd ? Theme.card : transparent;

    touch := TouchArea { }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Dot {
                tint: root.job.state == 2 ? Theme.success
                    : root.job.state == 4 ? Theme.danger
                    : root.job.state == 3 ? Theme.warning
                    : root.job.state == 1 ? Theme.indicator : Theme.border-strong;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.job.name;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: root.job.reason == 1 ? @tr("Already there: {}", root.job.detail)
                    : root.job.reason == 2 ? @tr("Not converted this way")
                    : root.job.reason == 4 ? @tr("→ {}", root.job.detail)
                    : root.job.detail;
                font-size: Theme.font-xs;
                color: root.job.state == 4 ? Theme.danger
                    : root.job.state == 3 ? Theme.warning : Theme.text-faint;
                overflow: elide;
            }
        }
        Text {
            width: 104px;
            text: root.job.way;
            font-size: Theme.font-sm;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        Cell {
            width: 76px;
            text: root.job.size;
        }
        Cell {
            width: 76px;
            text: root.job.result;
            color: Theme.text;
        }
        Cell {
            width: 52px;
            text: root.job.ratio;
            color: root.job.state == 2 ? Theme.brand : Theme.text-soft;
        }
        Text {
            width: 92px;
            text: root.job.state == 0 ? @tr("Waiting")
                : root.job.state == 1 ? @tr("Converting…")
                : root.job.state == 2 ? (root.job.way == ".bread → STL" ? @tr("Converted") : @tr("Checked"))
                : root.job.state == 3 ? @tr("Skipped") : @tr("Failed");
            font-size: Theme.font-sm;
            color: root.job.state == 2 ? Theme.success
                : root.job.state == 4 ? Theme.danger
                : root.job.state == 3 ? Theme.warning
                : root.job.state == 1 ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "Bread Converter";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1080px;
    preferred-height: 700px;
    min-width: 860px;
    min-height: 540px;
    background: Theme.ground;
    default-font-family: "Noto Sans";
    default-font-size: Theme.font;

    in property <string> version;
    in property <[JobRow]> jobs;
    // 0 nothing run yet, 1 converting, 2 done, 3 stopped.
    in property <int> phase;
    // Something to say instead: 1 nothing found to add, 2 no output folder.
    in property <int> notice;
    in property <int> file-count;
    in property <string> file-size;
    in property <int> done-count;
    in property <int> run-count;
    in property <string> bytes-done;
    in property <string> elapsed;
    in property <int> converted;
    in property <int> skipped;
    in property <int> failed;
    in property <float> progress;
    in property <bool> busy;
    in property <bool> dropping;
    in property <bool> can-open-output;
    // The summary of the last run, shown in tiles when it is over.
    in property <string> summary-before;
    in property <string> summary-after;

    property <string> files-text: @tr("{n} file" | "{n} files" % root.file-count);
    property <string> outcome-text: @tr("{} converted, {} skipped, {} failed", root.converted, root.skipped, root.failed);
    property <string> status-text: root.notice == 1 ? @tr("Nothing to add there: no STL or .bread files.")
        : root.notice == 2 ? @tr("Choose the folder to write into.")
        : root.phase == 1 ? @tr("Converting {} of {}: {} of {}, {}", Math.min(root.done-count + 1, root.run-count), root.run-count, root.bytes-done, root.file-size, root.elapsed)
        : root.phase == 2 ? @tr("Done in {}: {}", root.elapsed, root.outcome-text)
        : root.phase == 3 ? @tr("Stopped after {}: {}", root.elapsed, root.outcome-text)
        : root.file-count == 0 ? @tr("Add STL or .bread files to convert.")
        : @tr("{}, {}", root.files-text, root.file-size);

    in-out property <int> direction;
    in-out property <bool> subfolders: true;
    in-out property <int> output-mode;
    in-out property <string> output-folder;
    in-out property <bool> keep-tree: true;
    in-out property <int> when-there;
    in-out property <bool> about-open;
    // 0 English, 1 Spanish.
    in-out property <int> language;

    callback add-files();
    callback add-folder();
    callback clear();
    callback convert();
    callback cancel();
    callback choose-output();
    callback open-output();
    callback settings-changed();
    callback open-url(string);
    callback language-picked(int);

    VerticalLayout {
        // The top bar.
        Rectangle {
            height: Theme.topbar-height;
            background: Theme.chrome;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Icon {
                        commands: Icons.logo;
                        color: Theme.brand;
                        size: 20px;
                    }
                }
                Text {
                    text: "Bread Converter";
                    font-size: Theme.font-lg;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Text {
                    text: @tr("STL and .bread, both ways, without losing a bit");
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Segmented {
                        width: 84px;
                        options: ["EN", "ES"];
                        current: root.language;
                        picked(i) => {
                            root.language = i;
                            root.language-picked(i);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ScButton {
                        kind: ButtonKind.ghost;
                        icon: Icons.info;
                        text: @tr("About");
                        clicked => {
                            root.about-open = true;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            // What to convert, and how.
            Rectangle {
                width: 300px;
                background: Theme.panel;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.border;
                }

                VerticalLayout {
                    padding: 16px;
                    padding-top: 10px;
                    spacing: 4px;

                    Card {
                        title: @tr("ADD");

                        HorizontalLayout {
                            spacing: 8px;
                            ScButton {
                                icon: Icons.plus;
                                text: @tr("Files…");
                                enabled: !root.busy;
                                horizontal-stretch: 1;
                                clicked => {
                                    root.add-files();
                                }
                            }
                            ScButton {
                                icon: Icons.folder;
                                text: @tr("Folder…");
                                enabled: !root.busy;
                                horizontal-stretch: 1;
                                clicked => {
                                    root.add-folder();
                                }
                            }
                        }
                        ScCheckBox {
                            text: @tr("Look inside subfolders");
                            checked <=> root.subfolders;
                            toggled => {
                                root.settings-changed();
                            }
                        }
                        Note {
                            text: @tr("Or drop files and folders on the list.");
                        }
                    }

                    Card {
                        title: @tr("CONVERT");

                        Segmented {
                            options: [@tr("Both ways"), @tr("STL → .bread"), @tr(".bread → STL")];
                            current: root.direction;
                            enabled: !root.busy;
                            picked(i) => {
                                root.direction = i;
                                root.settings-changed();
                            }
                        }
                        Note {
                            text: root.direction == 0
                                ? @tr("Each file by its extension: STL to .bread, .bread to STL.")
                                : root.direction == 1
                                ? @tr("STL files only, binary or ASCII. Each .bread file is read back and checked bit for bit before it is written.")
                                : @tr(".bread files only. Everything each file shows goes into one STL, in place.");
                        }
                    }

                    Card {
                        title: @tr("WRITE");

                        Segmented {
                            options: [@tr("Next to each file"), @tr("Into a folder")];
                            current: root.output-mode;
                            enabled: !root.busy;
                            picked(i) => {
                                root.output-mode = i;
                                root.settings-changed();
                            }
                        }
                        if root.output-mode == 1: HorizontalLayout {
                            spacing: 6px;
                            ScLineEdit {
                                text <=> root.output-folder;
                                placeholder-text: @tr("Choose a folder");
                                enabled: !root.busy;
                                horizontal-stretch: 1;
                                edited => {
                                    root.settings-changed();
                                }
                            }
                            ScButton {
                                icon: Icons.folder;
                                enabled: !root.busy;
                                horizontal-stretch: 0;
                                clicked => {
                                    root.choose-output();
                                }
                            }
                        }
                        if root.output-mode == 1: ScCheckBox {
                            text: @tr("Keep the subfolders");
                            checked <=> root.keep-tree;
                            toggled => {
                                root.settings-changed();
                            }
                        }
                    }

                    Card {
                        title: @tr("IF THE FILE IS THERE");

                        Segmented {
                            options: [@tr("Skip"), @tr("Replace"), @tr("Keep both")];
                            current: root.when-there;
                            enabled: !root.busy;
                            picked(i) => {
                                root.when-there = i;
                                root.settings-changed();
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    if root.phase >= 2: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            StatTile {
                                value: root.converted;
                                caption: @tr("converted");
                            }
                            StatTile {
                                value: root.elapsed;
                                caption: @tr("time");
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            StatTile {
                                value: root.summary-before;
                                caption: @tr("before");
                            }
                            StatTile {
                                value: root.summary-after;
                                caption: @tr("after");
                            }
                        }
                    }
                }
            }

            // The files.
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.well;

                VerticalLayout {
                    Rectangle {
                        height: 30px;
                        background: Theme.chrome;

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.border-soft;
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;

                            Rectangle {
                                width: 8px;
                            }
                            Head {
                                text: @tr("FILE");
                                horizontal-stretch: 1;
                            }
                            Head {
                                width: 104px;
                                text: @tr("WAY");
                            }
                            Head {
                                width: 76px;
                                text: @tr("SIZE");
                                horizontal-alignment: right;
                            }
                            Head {
                                width: 76px;
                                text: @tr("RESULT");
                                horizontal-alignment: right;
                            }
                            Head {
                                width: 52px;
                                text: "%";
                                horizontal-alignment: right;
                            }
                            Head {
                                width: 92px;
                                text: @tr("STATE");
                            }
                        }
                    }

                    if root.jobs.length == 0: Rectangle {
                        vertical-stretch: 1;

                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: center;
                                Icon {
                                    commands: Icons.import;
                                    size: 44px;
                                    color: Theme.text-faint;
                                }
                            }
                            Text {
                                text: @tr("Drop STL and .bread files or folders here");
                                font-size: Theme.font-lg;
                                color: Theme.text-soft;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: @tr("or add them with Files… and Folder…");
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if root.jobs.length > 0: ListView {
                        vertical-stretch: 1;
                        for job[i] in root.jobs: Row {
                            job: job;
                            odd: Math.mod(i, 2) == 1;
                        }
                    }
                }

                if root.dropping: Rectangle {
                    background: Theme.ground.transparentize(0.15);
                    border-width: 2px;
                    border-color: Theme.brand;
                    border-radius: Theme.radius-lg;

                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: center;
                            Icon {
                                commands: Icons.import;
                                size: 48px;
                                color: Theme.brand;
                            }
                        }
                        Text {
                            text: @tr("Drop to add");
                            font-size: Theme.font-lg;
                            font-weight: 600;
                            color: Theme.text;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        // Progress, and the buttons that start and stop.
        Rectangle {
            height: 58px;
            background: Theme.chrome;

            Rectangle {
                height: 1px;
                y: 0;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: root.status-text;
                        color: Theme.text-soft;
                        overflow: elide;
                    }
                    ScProgress {
                        progress: root.progress;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ScButton {
                        icon: Icons.folder;
                        text: @tr("Open folder");
                        enabled: root.can-open-output;
                        clicked => {
                            root.open-output();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ScButton {
                        icon: Icons.trash;
                        text: @tr("Clear");
                        enabled: !root.busy && root.jobs.length > 0;
                        clicked => {
                            root.clear();
                        }
                    }
                }
                if root.busy: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ScButton {
                        icon: Icons.close;
                        text: @tr("Stop");
                        button-height: 32px;
                        clicked => {
                            root.cancel();
                        }
                    }
                }
                if !root.busy: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ScButton {
                        kind: ButtonKind.primary;
                        icon: Icons.export;
                        text: @tr("Convert");
                        button-height: 32px;
                        enabled: root.jobs.length > 0;
                        clicked => {
                            root.convert();
                        }
                    }
                }
            }
        }
    }

    // About, over the window.
    if root.about-open: Rectangle {
        background: #000000a0;

        TouchArea {
            clicked => {
                root.about-open = false;
            }
        }

        Rectangle {
            width: 440px;
            height: about.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.chrome;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.radius-lg;

            TouchArea { }

            about := VerticalLayout {
                padding: 18px;
                spacing: 12px;

                DialogHead {
                    icon: Icons.logo;
                    tint: Theme.brand;
                    title: "Bread Converter";
                    badge: root.version;
                    subtitle: @tr("STL and .bread, both ways, without losing a bit");
                    close-label: @tr("Close");
                    close => {
                        root.about-open = false;
                    }
                }
                DialogRule { }
                Note {
                    text: @tr("Part of bread-format, the open .bread format: tiny, lossless meshes and scenes. Apache-2.0. It carries meshoptimizer (MIT) and Zstandard (BSD), and the Noto Sans font (SIL OFL 1.1).");
                }
                HorizontalLayout {
                    spacing: 8px;
                    ScButton {
                        text: "bread.synrgs.tech";
                        clicked => {
                            root.open-url("https://bread.synrgs.tech");
                        }
                    }
                    ScButton {
                        text: "GitHub";
                        clicked => {
                            root.open-url("https://github.com/breadslicer-app/bread-format");
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                AboutSlint {
                    height: 80px;
                }
            }
        }
    }
}
